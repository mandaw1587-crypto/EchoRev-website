# Google Places API — https://console.cloud.google.com
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Hunter.io — https://hunter.io/api-keys
HUNTER_API_KEY=your_hunter_api_key

# Anthropic (email generation) — https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key

# Gmail sending — use an App Password, NOT your real Gmail password
# How to generate: myaccount.google.com → Security → App Passwords
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Your display name in outgoing emails
SENDER_NAME=Your Name

# Target city for local business search
TARGET_CITY=Miami, FL
